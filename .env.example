# Sunucu Portu
PORT=3000

# Kalıcı Veri Dizini (Railway Volume bağlarken /data yazın, yerelde boş bırakabilirsiniz)
DATA_DIR=./data

# Telegram Bot API Token (@BotFather üzerinden alınır)
TELEGRAM_BOT_TOKEN=

# Varsayılan Telegram Chat / Grup / Kanal ID (Ana Balina için ayarlandı)
TELEGRAM_DEFAULT_CHAT_ID=-5173499699

# Tarama Sıklığı (Saniye cinsinden, varsayılan: 5)
POLL_INTERVAL_SECONDS=5
